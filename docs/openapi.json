{
  "openapi": "3.0.3",
  "info": {
    "title": "园区能耗第一周 API",
    "version": "0.1.0",
    "description": "仅描述已实现接口；第二至四周见接口契约。"
  },
  "servers": [
    {
      "url": "http://127.0.0.1:8000"
    }
  ],
  "paths": {
    "/api/health": {
      "get": {
        "summary": "后端与数据库状态",
        "responses": {
          "200": {
            "description": "成功",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Envelope"
                }
              }
            }
          },
          "400": {
            "description": "请求无效",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Envelope"
                }
              }
            }
          },
          "500": {
            "description": "数据库或服务错误",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Envelope"
                }
              }
            }
          }
        }
      }
    },
    "/api/meta": {
      "get": {
        "summary": "主数据只读元信息",
        "responses": {
          "200": {
            "description": "成功",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Envelope"
                }
              }
            }
          },
          "400": {
            "description": "请求无效",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Envelope"
                }
              }
            }
          },
          "500": {
            "description": "数据库或服务错误",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Envelope"
                }
              }
            }
          }
        }
      }
    },
    "/api/raw-data/page": {
      "post": {
        "summary": "小时数据筛选分页",
        "responses": {
          "200": {
            "description": "成功",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Envelope"
                }
              }
            }
          },
          "400": {
            "description": "请求无效",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Envelope"
                }
              }
            }
          },
          "500": {
            "description": "数据库或服务错误",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Envelope"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RawQuery"
              },
              "example": {
                "areaId": 2,
                "pageNum": 1,
                "pageSize": 20
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Envelope": {
        "type": "object",
        "required": [
          "code",
          "message",
          "data"
        ],
        "properties": {
          "code": {
            "type": "integer"
          },
          "message": {
            "type": "string"
          },
          "data": {
            "nullable": true,
            "type": "object"
          }
        }
      },
      "RawQuery": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "areaId": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2147483647
          },
          "deviceId": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2147483647
          },
          "energyType": {
            "type": "string",
            "enum": [
              "ELECTRIC",
              "WATER"
            ]
          },
          "dataQuality": {
            "type": "integer",
            "minimum": 1,
            "maximum": 3
          },
          "pageNum": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2147483647,
            "default": 1
          },
          "pageSize": {
            "type": "integer",
            "minimum": 1,
            "maximum": 200,
            "default": 20
          },
          "startTime": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2} \\d{2}:\\d{2}:\\d{2}$"
          },
          "endTime": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2} \\d{2}:\\d{2}:\\d{2}$"
          }
        }
      }
    }
  }
}
